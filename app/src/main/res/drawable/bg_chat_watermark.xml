<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/chat_background" />
    </item>

    <!-- Top Left -->
    <item
        android:drawable="@drawable/ic_default_restaurant"
        android:alpha="0.05"
        android:gravity="top|left"
        android:top="100dp"
        android:left="40dp"
        android:width="120dp"
        android:height="120dp" />

    <!-- Center Right -->
    <item
        android:drawable="@drawable/ic_default_restaurant"
        android:alpha="0.05"
        android:gravity="center|right"
        android:right="40dp"
        android:width="100dp"
        android:height="100dp" />

    <!-- Bottom Left -->
    <item
        android:drawable="@drawable/ic_default_restaurant"
        android:alpha="0.05"
        android:gravity="bottom|left"
        android:bottom="150dp"
        android:left="20dp"
        android:width="110dp"
        android:height="110dp" />

</layer-list>
